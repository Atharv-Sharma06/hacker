index 0000000..4495270
--- /dev/null
+++ b/packages/core/src/services/exec/node/git-ssh-command.ts
@@ -0,0 +1,63 @@
+import { createBoundExec } from '#services/exec/api';
+
+/** What emdash's git runs over when neither the user nor git config picks an ssh command. */
+export const DEFAULT_GIT_SSH_COMMAND = 'ssh -o BatchMode=yes';
+
+const PROBE_TTL_MS = 60_000;
+
+const probes = new Map<string, { expiresAt: number; configured: boolean }>();
+
+/**
+ * Whether git would already pick its own ssh command for work in `cwd`: an explicit
+ * `GIT_SSH_COMMAND` in the environment, or an effective `core.sshCommand` (repository
+ * config inside a checkout, global/system config elsewhere — including a clone
+ * target's parent directory). Probed through git itself so includes, conditional
+ * includes, and worktree config all apply; cached briefly per cwd because every
+ * git invocation asks.
+ *
+ * `GIT_SSH_COMMAND` outranks `core.sshCommand`, so emdash must not export its
+ * batch-mode default whenever the user configured a wrapper (key routing, proxies,
+ * 1Password-style agents): that silently bypasses it and clones fail that work in a
+ * terminal. Prompts stay disabled either way — GIT_TERMINAL_PROMPT=0 and empty
+ * askpass variables apply regardless of which ssh command runs.
+ */
+export async function hasConfiguredSshCommand(
+  cwd: string,
+  env: NodeJS.ProcessEnv,
+  executable = 'git'
+): Promise<boolean> {
+  if (env.GIT_SSH_COMMAND) return true;
+  const key = `${executable}\0${cwd}`;
+  const now = Date.now();
+  const cached = probes.get(key);
+  if (cached && cached.expiresAt > now) return cached.configured;
+
+  let configured = false;
+  try {
+    const { stdout } = await createBoundExec({ file: executable, cwd, env }).exec([
+      'config',
+      '--get',
+      'core.sshCommand',
+    ]);
+    configured = stdout.trim().length > 0;
+  } catch {
+    // Exit 1 means unset; anything else (no git on PATH, unreadable cwd) means there
+    // is no wrapper we could be bypassing, so the batch-mode default is right.
+  }
+  probes.set(key, { expiresAt: now + PROBE_TTL_MS, configured });
+  return configured;
+}
+
+/** Adds the batch-mode default only when nothing else chooses the ssh command. */
+export function withDefaultSshCommand(
+  env: NodeJS.ProcessEnv,
+  configured: boolean
+): NodeJS.ProcessEnv {
+  if (configured || env.GIT_SSH_COMMAND) return env;
+  return { ...env, GIT_SSH_COMMAND: DEFAULT_GIT_SSH_COMMAND };
+}
+
+/** Test seam: forgets probe results so a config change is observed immediately. */
+export function resetSshCommandProbes(): void {
+  probes.clear();
+}
