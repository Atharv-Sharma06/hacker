+/**
+ * A linked worktree carries a `.git` *file* of the form `gitdir: <repo>/.git/worktrees/<name>`.
+ * A `.git` directory (nested repository) or a `gitdir:` into `modules/` (submodule) is not one.
+ */
+async function isLinkedWorktree(directory: string, children: Dirent[]): Promise<boolean> {
+  const marker = children.find((child) => child.name === '.git');
+  if (!marker?.isFile()) return false;
+  try {
+    const content = await readFile(path.join(directory, '.git'), 'utf8');
+    const match = /^gitdir:\s*(.+?)\s*$/mu.exec(content);
+    if (!match?.[1]) return false;
+    const segments = match[1].replace(/\\/gu, '/').split('/');
+    return segments.includes('worktrees');
+  } catch {
+    return false;
+  }
+}
