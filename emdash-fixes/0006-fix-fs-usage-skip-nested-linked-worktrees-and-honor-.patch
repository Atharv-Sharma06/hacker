+import { promises as fs } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { measureAbsolutePathUsage } from './index';
+
+describe('measureAbsolutePathUsage', () => {
+  let root: string;
+
+  beforeEach(async () => {
+    root = await fs.realpath(await fs.mkdtemp(path.join(os.tmpdir(), 'fs-usage-')));
+  });
+
+  afterEach(async () => {
+    await fs.rm(root, { recursive: true, force: true });
+  });
+
+  async function write(relative: string, bytes: number): Promise<void> {
+    const target = path.join(root, relative);
+    await fs.mkdir(path.dirname(target), { recursive: true });
+    await fs.writeFile(target, Buffer.alloc(bytes, 1));
+  }
+
+  it('skips nested linked worktrees but keeps submodules and nested repositories', async () => {
+    await write('src/app.ts', 4096);
+    // A linked worktree of this (or any) repository: measured as its own workspace.
+    await write('.claude/worktrees/task-1/.git', 0);
+    await fs.writeFile(
+      path.join(root, '.claude/worktrees/task-1/.git'),
+      `gitdir: ${path.join(root, '.git/worktrees/task-1')}\n`
+    );
+    await write('.claude/worktrees/task-1/big.bin', 1 << 20);
+    // A submodule checkout belongs to this workspace.
+    await write('vendor/lib/lib.c', 4096);
+    await fs.writeFile(
+      path.join(root, 'vendor/lib/.git'),
+      `gitdir: ${path.join(root, '.git/modules/vendor/lib')}\n`
+    );
+    // A nested repository with its own .git directory also stays included.
+    await write('third-party/tool/.git/HEAD', 64);
+    await write('third-party/tool/tool.sh', 4096);
+
+    const everything = await measureAbsolutePathUsage(root, '');
+    const withoutWorktree = await measureAbsolutePathUsage(
+      path.join(root, '.claude/worktrees/task-1'),
+      ''
+    );
+
+    expect(everything.errors).toEqual([]);
+    expect(everything.exclusiveDiskBytes).toBeGreaterThanOrEqual(3 * 4096);
+    expect(everything.exclusiveDiskBytes).toBeLessThan(withoutWorktree.exclusiveDiskBytes);
+    expect(withoutWorktree.exclusiveDiskBytes).toBeGreaterThanOrEqual(1 << 20);
+  });
+
+  it('measures a linked worktree itself when it is the root', async () => {
+    await fs.writeFile(path.join(root, '.git'), `gitdir: /elsewhere/.git/worktrees/x\n`);
+    await write('data.bin', 8192);
+
+    const usage = await measureAbsolutePathUsage(root, '');
+
+    expect(usage.exclusiveDiskBytes).toBeGreaterThanOrEqual(8192);
+  });
+
+  it('stops when the signal aborts', async () => {
+    await write('a/b/c.bin', 1024);
+    const controller = new AbortController();
+    controller.abort(new Error('left the view'));
+
+    await expect(measureAbsolutePathUsage(root, '', { signal: controller.signal })).rejects.toThrow(
+      'left the view'
+    );
+  });
+});
