From 597644c1baabc7133b44e39adb66f6f4856ef95f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 02:29:48 +0000
Subject: [PATCH 5/6] fix(git-credentials): say so when the helper cannot reach
 the desktop

The injected credential helper swallowed every curl failure (2>/dev/null || true).
When the loopback credential server was unreachable, git saw an empty answer and
failed with the misleading 'could not read Username ... Device not configured',
while the session's GIT_CONFIG_* helper silently overrode a working ~/.gitconfig.

Keep the fall-through (empty stdout, exit 0) so git behaves as before, but print one
line on stderr naming the loopback address and curl's exit status; git relays helper
stderr to the user, so the real cause is now visible.

Refs generalaction/emdash#3192

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Lf1ZxTXikvVa7e1BpWKy1d
---
 .../git-credentials/api/env.test.ts           | 33 ++++++++++++++++++-
 .../src/primitives/git-credentials/api/env.ts | 12 +++++--
 2 files changed, 41 insertions(+), 4 deletions(-)

diff --git a/packages/core/src/primitives/git-credentials/api/env.test.ts b/packages/core/src/primitives/git-credentials/api/env.test.ts
index 1fcaabb..20c602a 100644
--- a/packages/core/src/primitives/git-credentials/api/env.test.ts
+++ b/packages/core/src/primitives/git-credentials/api/env.test.ts
@@ -1,4 +1,4 @@
-import { execFileSync } from 'node:child_process';
+import { execFileSync, spawnSync } from 'node:child_process';
 import { chmodSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
 import { devNull, tmpdir } from 'node:os';
 import { join } from 'node:path';
@@ -81,6 +81,37 @@ describe('GIT_CREDENTIAL_HELPER_COMMAND', () => {
     );
   });
 
+  it.skipIf(process.platform === 'win32')(
+    'reports an unreachable desktop on stderr and yields nothing on stdout',
+    () => {
+      const bin = mkdtempSync(join(tmpdir(), 'emdash-helper-'));
+      try {
+        // curl's exit 7: could not connect to the loopback port.
+        writeFileSync(join(bin, 'curl'), '#!/bin/sh\ncat >/dev/null\nexit 7\n');
+        chmodSync(join(bin, 'curl'), 0o755);
+        const result = spawnSync(
+          'sh',
+          ['-c', `${GIT_CREDENTIAL_HELPER_COMMAND.slice(1)} "$@"`, 'sh', 'get'],
+          {
+            env: {
+              PATH: `${bin}:${process.env.PATH}`,
+              EMDASH_GIT_CREDENTIAL_PORT: String(channel.port),
+              EMDASH_GIT_CREDENTIAL_NONCE: channel.nonce,
+            },
+            input: 'protocol=https\nhost=github.com\n\n',
+            encoding: 'utf8',
+          }
+        );
+        expect(result.status).toBe(0);
+        expect(result.stdout).toBe('');
+        expect(result.stderr).toContain(`127.0.0.1:${channel.port}`);
+        expect(result.stderr).toContain('curl exit 7');
+      } finally {
+        rmSync(bin, { recursive: true, force: true });
+      }
+    }
+  );
+
   it('waits longer than a credential read that renews the token', () => {
     expect(GIT_CREDENTIAL_HELPER_TIMEOUT_SECONDS).toBeGreaterThan(60);
     expect(GIT_CREDENTIAL_HELPER_COMMAND).toContain(`-m ${GIT_CREDENTIAL_HELPER_TIMEOUT_SECONDS} `);
diff --git a/packages/core/src/primitives/git-credentials/api/env.ts b/packages/core/src/primitives/git-credentials/api/env.ts
index ac38e6c..d71947d 100644
--- a/packages/core/src/primitives/git-credentials/api/env.ts
+++ b/packages/core/src/primitives/git-credentials/api/env.ts
@@ -64,15 +64,21 @@ export const GIT_CREDENTIAL_HELPER_ERASE_URL_PATH = `${GIT_CREDENTIAL_HELPER_PAT
  * appears in git config values or process argv. `get` returns the credential;
  * `erase` reports one the remote rejected (git sends it after an
  * authentication failure) and prints nothing; `store` is a no-op. Only those
- * two literal actions reach the URL. Failures print nothing, so git falls
- * through to its normal prompting behavior.
+ * two literal actions reach the URL. A failed request prints nothing on stdout,
+ * so git falls through to its normal prompting behavior — but it does say so on
+ * stderr (which git relays to the user) naming the loopback address and curl's
+ * exit status. Otherwise the only symptom of a dead or unreachable desktop
+ * server is git's unrelated "could not read Username" failure, with the
+ * session's own helper config silently overriding a working `~/.gitconfig`.
  */
 export const GIT_CREDENTIAL_HELPER_COMMAND =
   '!f() { case "$1" in get|erase) ' +
   `curl -s -f -m ${GIT_CREDENTIAL_HELPER_TIMEOUT_SECONDS} -X POST --data-binary @- ` +
   `-H "X-Emdash-Token: $${GIT_CREDENTIAL_NONCE_ENV_VAR}" ` +
   `"http://127.0.0.1:$${GIT_CREDENTIAL_PORT_ENV_VAR}${GIT_CREDENTIAL_HELPER_PATH_PREFIX}$1" ` +
-  '2>/dev/null || true;; esac; }; f';
+  '2>/dev/null || echo "emdash: git credential helper could not get a credential from ' +
+  `the Emdash app at 127.0.0.1:$${GIT_CREDENTIAL_PORT_ENV_VAR} (curl exit $?); ` +
+  'git continues without it" >&2;; esac; }; f';
 
 const CREDENTIAL_HELPER_CONFIG_KEY = /^credential(\..+)?\.helper$/i;
 
